<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1FAEE"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Badge Vault &amp; Mastery System"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1D3557"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#D6EAF8"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥉 Bronze Badge (Beginner Explorer)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1D3557"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Unlocked (2+ productive hours completed)"
                    android:textSize="14sp"
                    android:textColor="#457B9D"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#D6EAF8"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥈 Silver Badge (Regular Practitioner)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1D3557"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Unlocked (Consistent multi-day interaction)"
                    android:textSize="14sp"
                    android:textColor="#457B9D"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E6C280"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥇 Gold Badge (Dedicated Scholar)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1D3557"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Locked (Complete multi-week sessions)"
                    android:textSize="14sp"
                    android:textColor="#457B9D"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#A8DADC"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💎 Platinum Badge (Advanced Creator)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1D3557"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Locked (Master multi-modal features)"
                    android:textSize="14sp"
                    android:textColor="#457B9D"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
